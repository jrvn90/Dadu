rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().roles.hasAny(['admin']);
    }

    function isSupervisor() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().roles.hasAny(['supervisor']);
    }

    function isSameOrg(orgId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().organizationId == orgId;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isSupervisor());
      allow list: if isSignedIn() && (isAdmin() || isSupervisor());
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().id == userId &&
        incoming().status == 'pending' &&
        incoming().roles.size() == 1 &&
        incoming().roles[0] == 'teacher'; // Prevent self-assigning admin
      allow update: if isSignedIn() && (
        (isAdmin() && isValidId(userId)) ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'avatarType', 'phoneNumber', 'updatedAt']))
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Organizations
    match /organizations/{orgId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin() && isValidId(orgId);
    }

    // Institution Settings
    match /institutionSettings/{settingsId} {
      allow get, list: if isSignedIn() && isSameOrg(existing().organizationId);
      allow create, update, delete: if isAdmin() && isValidId(settingsId);
    }

    // Academic Years & Semesters
    match /academicYears/{id} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(id);
    }

    match /semesters/{id} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(id);
    }

    // Classes & Students
    match /classes/{classId} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(classId);
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if (isAdmin() || (isSignedIn() && isSameOrg(incoming().organizationId))) && isValidId(studentId);
    }

    // Subjects & Schedules
    match /subjects/{subjectId} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(subjectId);
    }

    match /teacherAssignments/{id} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(id);
    }

    match /schedules/{scheduleId} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(scheduleId);
    }

    // Attendance Sessions & Records
    match /attendanceSessions/{sessionId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create: if isSignedIn() && isSameOrg(incoming().organizationId) && incoming().teacherId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || (isSameOrg(existing().organizationId) && existing().teacherId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(sessionId);
    }

    match /attendanceRecords/{recordId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create: if isSignedIn() && isSameOrg(incoming().organizationId);
      allow update: if isSignedIn() && (isAdmin() || isSameOrg(existing().organizationId));
      allow delete: if isAdmin() && isValidId(recordId);
    }

    // Teaching Journals
    match /teachingJournals/{journalId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create: if isSignedIn() && isSameOrg(incoming().organizationId) && incoming().teacherId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || (isSameOrg(existing().organizationId) && existing().teacherId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(journalId);
    }

    // Assessments & Grades
    match /assessments/{assessmentId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create, update: if isSignedIn() && (isAdmin() || (isSameOrg(incoming().organizationId) && incoming().teacherId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(assessmentId);
    }

    match /grades/{gradeId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create, update: if isSignedIn() && (isAdmin() || (isSameOrg(incoming().organizationId) && incoming().teacherId == request.auth.uid));
      allow delete: if isAdmin() && isValidId(gradeId);
    }

    // Homeroom & Student Notes
    match /homeroomAssignments/{id} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(id);
    }

    match /studentNotes/{noteId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create, update: if isSignedIn() && isSameOrg(incoming().organizationId);
      allow delete: if isAdmin() && isValidId(noteId);
    }

    // Document Templates & Snapshots
    match /documentTemplates/{templateId} {
      allow read: if isSignedIn() && isSameOrg(existing().organizationId);
      allow write: if isAdmin() && isValidId(templateId);
    }

    match /generatedDocuments/{docId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || isSupervisor());
      allow create: if isSignedIn() && isSameOrg(incoming().organizationId);
      allow update, delete: if isAdmin() && isValidId(docId);
    }

    // Supervision Assignments
    match /supervisorAssignments/{assignId} {
      allow read: if isSignedIn() && (isSameOrg(existing().organizationId) || request.auth.uid == existing().supervisorId || request.auth.uid == existing().teacherId);
      allow write: if isAdmin() && isValidId(assignId);
    }

    // Audit Logs (Immutable append-only for actors, readable by admins)
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false; // Strict immutability
    }
  }
}
