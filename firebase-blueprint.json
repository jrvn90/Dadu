{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with roles, organization membership, and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "fullName": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 100 },
        "roles": { "type": "array" },
        "status": { "type": "string", "enum": ["pending", "active", "disabled", "archived", "deleted"] },
        "isPrimaryAdmin": { "type": "boolean" },
        "avatarType": { "type": "string", "enum": ["male_formal", "female_hijab", "custom_upload"] },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "nip": { "type": "string", "maxLength": 50 },
        "nuptk": { "type": "string", "maxLength": 50 },
        "position": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "email", "fullName", "roles", "status", "createdAt", "updatedAt"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Educational institution organization unit.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 50 },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "code", "status", "createdAt", "updatedAt"]
    },
    "InstitutionSettings": {
      "title": "InstitutionSettings",
      "description": "Central configuration for institution identity, leadership, and dynamic terminology.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "institutionName": { "type": "string", "maxLength": 200 },
        "institutionType": { "type": "string", "maxLength": 100 },
        "parentOrganizationName": { "type": "string", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 500 },
        "village": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "cityRegency": { "type": "string", "maxLength": 100 },
        "province": { "type": "string", "maxLength": 100 },
        "postalCode": { "type": "string", "maxLength": 20 },
        "phone": { "type": "string", "maxLength": 50 },
        "email": { "type": "string", "maxLength": 256 },
        "headName": { "type": "string", "maxLength": 150 },
        "headTitle": { "type": "string", "maxLength": 100 },
        "headIdentifier": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "institutionName", "headName", "headTitle", "createdAt", "updatedAt"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Classroom group for an academic year.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "level": { "type": "string", "maxLength": 50 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "capacity": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "archived"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "name", "level", "academicYearId", "status", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student master profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "nis": { "type": "string", "maxLength": 50 },
        "nisn": { "type": "string", "maxLength": 50 },
        "fullName": { "type": "string", "maxLength": 150 },
        "gender": { "type": "string", "enum": ["L", "P"] },
        "birthPlace": { "type": "string", "maxLength": 100 },
        "birthDate": { "type": "string", "maxLength": 20 },
        "classId": { "type": "string", "maxLength": 128 },
        "academicYearId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["active", "graduated", "transferred", "inactive"] },
        "qrToken": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "nis", "fullName", "gender", "classId", "academicYearId", "status", "createdAt", "updatedAt"]
    },
    "AttendanceSession": {
      "title": "AttendanceSession",
      "description": "Teacher attendance session for a class and schedule.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "mode": { "type": "string", "enum": ["manual", "qr", "hybrid"] },
        "status": { "type": "string", "enum": ["open", "closed", "expired"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "teacherId", "classId", "subjectId", "date", "mode", "status", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual student attendance status in a session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "studentId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["Hadir", "Sakit", "Izin", "Alpa", "Dispensasi"] },
        "recordedAt": { "type": "string" },
        "recordedBy": { "type": "string", "maxLength": 128 },
        "method": { "type": "string", "enum": ["manual", "qr_scan"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "sessionId", "studentId", "status", "recordedAt", "recordedBy", "method", "createdAt", "updatedAt"]
    },
    "TeachingJournal": {
      "title": "TeachingJournal",
      "description": "Teaching activities and reflection entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "teacherId": { "type": "string", "maxLength": 128 },
        "classId": { "type": "string", "maxLength": 128 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "learningTopic": { "type": "string", "maxLength": 300 },
        "learningObjective": { "type": "string", "maxLength": 1000 },
        "activity": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "organizationId", "teacherId", "classId", "subjectId", "date", "learningTopic", "learningObjective", "activity", "createdAt", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable security and action audit record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "organizationId": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 100 },
        "entityType": { "type": "string", "maxLength": 100 },
        "entityId": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "organizationId", "actorId", "actorName", "action", "entityType", "entityId", "timestamp"]
    }
  },
  "firestore": {
    "/organizations/{organizationId}": {
      "schema": "Organization",
      "description": "Organization units"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and RBAC metadata"
    },
    "/institutionSettings/{settingsId}": {
      "schema": "InstitutionSettings",
      "description": "Institution identity and dynamic terminology"
    },
    "/classes/{classId}": {
      "schema": "ClassRoom",
      "description": "Classrooms"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Students"
    },
    "/attendanceSessions/{sessionId}": {
      "schema": "AttendanceSession",
      "description": "Attendance sessions"
    },
    "/attendanceRecords/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Attendance status records"
    },
    "/teachingJournals/{journalId}": {
      "schema": "TeachingJournal",
      "description": "Teacher classroom journals"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail log records"
    }
  }
}
